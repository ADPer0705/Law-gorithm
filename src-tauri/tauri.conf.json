{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Law-gorithm",
  "version": "0.1.0",
  "identifier": "com.lawgorithm.app",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Law-gorithm",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Privacy-First Legal AI Assistant",
    "longDescription": "A desktop application for legal document analysis with privacy-first approach",
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright (c) 2025 Law-gorithm",
    "licenseFile": "",
    "windows": {
      "certificateThumbprint": "",
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libtesseract4", "libleptonica-dev", "python3"]
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      }
    }
  }
}
